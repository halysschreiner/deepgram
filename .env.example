# Chave inicial opcional. Também pode ser configurada pelo botão API Key na interface.
# A configuração salva na interface tem prioridade sobre estes dois valores.
DEEPGRAM_API_KEY=
# Opcional: selecione o projeto de transcrição se a chave acessar vários projetos.
DEEPGRAM_PROJECT_ID=
PORT=8765
# Limite de upload em MB. Teto da Deepgram para arquivo local: 2048.
MAX_UPLOAD_MB=500
DEEPGRAM_TIMEOUT_SECONDS=1800
# Interface de publicação. 127.0.0.1 = só local; IP do Tailscale = acessível no tailnet.
BIND_ADDR=127.0.0.1
# Hosts aceitos no header Host (allowlist exata, barra DNS rebinding). Mantenha 127.0.0.1 (healthcheck).
ALLOWED_HOSTS=localhost,127.0.0.1,::1
